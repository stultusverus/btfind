# Copy to /etc/btfind/observability.env with mode 0600.
# Supply real resource OCIDs during the later infrastructure deployment.
# Never commit production OCIDs, API keys, or private keys.

OCI_REGION=ap-osaka-1
INSTANCE_NAME=vm-sub01

BTFIND_CRAWLER_LOG_OCID=ocid1.log.oc1.ap-osaka-1.aaaaaaaaexample
BTFIND_WEB_LOG_OCID=ocid1.log.oc1.ap-osaka-1.aaaaaaaaexample
OCI_METRICS_COMPARTMENT_OCID=ocid1.compartment.oc1..aaaaaaaaexample

BTFIND_INSTANCE_USER=opc
JOURNAL_LOOKBACK_SECONDS=300
JOURNAL_MAX_RECORDS=200
JOURNAL_MAX_BYTES=262144
JOURNAL_MAX_BATCHES=10
LOG_ENTRY_MAX_CHARS=10000
LOG_BATCH_MAX_ENTRIES=200
DEAD_LETTER_MAX_BYTES=8388608
METRICS_MAX_AGE_SECONDS=6900
METRICS_BATCH_MAX_POINTS=40
OCI_MAX_ATTEMPTS=5
OCI_API_TIMEOUT_SECONDS=8
LOG_EXPORT_BUDGET_SECONDS=25
METRICS_EXPORT_BUDGET_SECONDS=25
LOG_EXPORT_HARD_TIMEOUT_SECONDS=35
METRICS_EXPORT_HARD_TIMEOUT_SECONDS=35
STATE_DIR=/var/lib/btfind-observability
